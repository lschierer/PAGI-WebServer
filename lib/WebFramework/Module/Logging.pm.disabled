package WebFramework::::Logging;
use v5.42.0;
use utf8::all;
use Mooish::Base -standard;
with 'WebFramework::Role::LogConfig';
extends 'Thunderhorse::Module::Logger';
require Data::Printer;
use Log::Handler;
use Carp;

sub build ($self, @args) {

  $self->setup_access_log();
  $self->add_outputs();

  $self->SUPER::build();
}

1;
__END__
