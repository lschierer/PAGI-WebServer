[%# wrap this partial in <div class="directory-index"></div> %]
[% IF entries.size > 0 %]
  <ul class="spectrum-List spectrum-List--sizeM grid-index">
    [% FOREACH entry IN entries %]
      <li class="spectrum-List-item">
        <a href="[% entry.path %]" class="spectrum-Link">
          [% IF entry.type == 'directory' %]
            <iconify-icon icon="ion:folder-open-outline" class="spectrum-Icon spectrum-Icon--sizeS"></iconify-icon>
          [% ELSE %]
            <iconify-icon icon="ion:document-text-outline" class="spectrum-Icon spectrum-Icon--sizeS"></iconify-icon>
          [% END %]
          [% entry.title %]
        </a>
      </li>
    [% END %]
  </ul>
[% ELSE %]
  <p class="spectrum-Body spectrum-Body--sizeM">This directory is empty.</p>
[% END %]
